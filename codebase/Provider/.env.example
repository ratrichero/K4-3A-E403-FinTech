# ==============================================================================
# LLM Provider Configuration Template (.env)
# ==============================================================================
# Copy this file to `.env` in your project root and update with your own keys.
# NEVER commit your actual `.env` file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER
# ------------------------------------------------------------------------------
# Default provider uses OpenAI or any OpenAI-compatible API endpoint.
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT=60.0

# Base URL:
# - Leave blank or commented out to use official OpenAI (https://api.openai.com/v1)
# - Or set to any OpenAI-compatible provider:
#
# Groq (Ultra-fast inference, free tier available):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=llama-3.3-70b-versatile
#
# DeepSeek (Cost-effective & powerful reasoning):
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
#
# OpenRouter (One key for 100+ models):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=anthropic/claude-3.5-sonnet
#
# Ollama (Local LLM, 100% free, no API key needed):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_NAME=llama3.2
#
# vLLM / Local OpenAI compatible server:
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=dummy

# ------------------------------------------------------------------------------
# 2. FALLBACK LLM 1 (Optional - auto switches if Primary hits rate limit / 5xx)
# ------------------------------------------------------------------------------
FALLBACK_OPENAI_API_KEY=
FALLBACK_OPENAI_BASE_URL=
FALLBACK_MODEL_NAME=
# Example: Fallback to DeepSeek when OpenAI fails:
# FALLBACK_OPENAI_API_KEY=sk-your-deepseek-api-key
# FALLBACK_OPENAI_BASE_URL=https://api.deepseek.com/v1
# FALLBACK_MODEL_NAME=deepseek-chat

# ------------------------------------------------------------------------------
# 3. FALLBACK LLM 2 (Optional - second safety net)
# ------------------------------------------------------------------------------
FALLBACK2_OPENAI_API_KEY=
FALLBACK2_OPENAI_BASE_URL=
FALLBACK2_MODEL_NAME=
# Example: Fallback to Groq if both Primary and DeepSeek fail:
# FALLBACK2_OPENAI_API_KEY=gsk_your_groq_api_key
# FALLBACK2_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK2_MODEL_NAME=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. OTHER POPULAR NATIVE PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Anthropic Claude:
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# Google Gemini:
# GOOGLE_API_KEY=AIzaSy...
